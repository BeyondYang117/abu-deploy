# Abu API standalone deploy
# cp .env.example .env && edit values before first start

# Default: Team image (latest; Team features unlock with a Team license).
# Personal free deploy still works with LICENSE_CODE empty.
ABU_API_IMAGE=abu116/abu-api-team:latest
# Optional: Personal-only channel (no Team edition in the image):
# ABU_API_IMAGE=abu116/abu-api:latest

# Leave empty for built-in free (Personal) license.
# Get a personal code or upgrade at https://www.abuai.chat/
LICENSE_CODE=

# SQLite (default, zero external DB). For MySQL, set SQL_DSN and clear SQLITE_PATH usage.
SQL_DSN=local
SQLITE_PATH=/data/abu-api.db
# SQL_DSN=abu_user:CHANGE_ME@tcp(host.docker.internal:3306)/abu_api?parseTime=true&interpolateParams=true

REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS
CRYPTO_SECRET=CHANGE_ME_CRYPTO_SECRET_MIN_32_CHARS
# Prefer: openssl rand -base64 32
CARD_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

ALLOWED_ORIGINS=http://localhost:3004,http://127.0.0.1:3004

TZ=Asia/Shanghai
