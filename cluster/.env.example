# Abu API small-cluster deploy (single host: master + slaves + gateway)
# Multi-instance usually requires Team / Enterprise license.
# cp .env.example .env && edit values before first start

# Default: Team image (latest). Same default as standalone/.
ABU_API_IMAGE=abu116/abu-api-team:latest
# Optional: Personal-only channel (no Team edition) — not recommended for cluster:
# ABU_API_IMAGE=abu116/abu-api:latest

# This template ships two fixed slaves (slave-1 / slave-2) for stable HAProxy DNS.
# To add more, copy a slave service block and update haproxy.cfg.

# External MySQL is required for cluster mode.
SQL_DSN=abu_user:CHANGE_ME@tcp(host.docker.internal:3306)/abu_api?parseTime=true&interpolateParams=true&timeout=10s&readTimeout=30s&writeTimeout=30s
LOG_SQL_DSN=

REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
REDIS_CONN_STRING=redis://:CHANGE_ME_TO_A_STRONG_PASSWORD@redis:6379/0
COORDINATION_REDIS_CONN_STRING=redis://:CHANGE_ME_TO_A_STRONG_PASSWORD@redis-coordination:6379/0

# openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS
CRYPTO_SECRET=CHANGE_ME_CRYPTO_SECRET_MIN_32_CHARS
CARD_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

ALLOWED_ORIGINS=http://localhost:8004,https://your-domain.com

# Leave empty for free personal limits (single-instance oriented).
# Set Team/Enterprise code before relying on multi-instance capacity.
LICENSE_CODE=

TZ=Asia/Shanghai
