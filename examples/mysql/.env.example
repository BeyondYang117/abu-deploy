# Standalone + MySQL sample
# cp .env.example .env && edit secrets, then: docker compose up -d

ABU_API_IMAGE=abu116/abu-api-team:latest
LICENSE_CODE=

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=abu_api
MYSQL_USER=abu
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

# Must match MySQL service credentials / database name above.
SQL_DSN=abu:CHANGE_ME_MYSQL_PASSWORD@tcp(mysql:3306)/abu_api?parseTime=true&interpolateParams=true&timeout=10s&readTimeout=30s&writeTimeout=30s

REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS
CRYPTO_SECRET=CHANGE_ME_CRYPTO_SECRET_MIN_32_CHARS
CARD_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

ALLOWED_ORIGINS=http://localhost:3004,http://127.0.0.1:3004
TZ=Asia/Shanghai
