# Standalone + PostgreSQL sample
# cp .env.example .env && edit secrets, then: docker compose up -d

ABU_API_IMAGE=abu116/abu-api-team:latest

# License (授权码)
# - Leave empty → built-in free Personal plan (开箱即用，无需注册)
# - Free personal code / paid Team·Enterprise → https://www.abuai.chat/
# LICENSE_CODE=your_license_code
LICENSE_CODE=

POSTGRES_DB=abu_api
POSTGRES_USER=abu
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Must use postgres:// or postgresql:// prefix so Abu API selects PostgreSQL.
SQL_DSN=postgres://abu:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/abu_api?sslmode=disable

REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS
CRYPTO_SECRET=CHANGE_ME_CRYPTO_SECRET_MIN_32_CHARS
CARD_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

ALLOWED_ORIGINS=http://localhost:3004,http://127.0.0.1:3004
TZ=Asia/Shanghai
